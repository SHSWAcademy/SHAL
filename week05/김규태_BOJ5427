import java.io.*;
import java.util.*;

public class Main {
    private static int n, m;
    private static char[][] graph;
    private static int[][] fTime;
    private static int[][] jTime;
    private static boolean[][] visited;
    private static int[] dr = {-1, 1, 0, 0};
    private static int[] dc = {0, 0, -1, 1};
    private static StringBuilder sb = new StringBuilder();
    private static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
    public static void main(String[] args) throws IOException {
        int T = Integer.parseInt(br.readLine());
        for (int i = 0; i < T; i++) {
            solution();
        }
        System.out.print(sb.toString());
    }
    private static void solution() throws IOException {

        String[] strArr = br.readLine().split(" ");
        m = Integer.parseInt(strArr[0]);
        n = Integer.parseInt(strArr[1]);

        graph = new char[n][m];
        fTime = new int[n][m];
        jTime = new int[n][m];
        visited = new boolean[n][m];

        Node jihun = null;
        ArrayDeque<Node> flameQueue = new ArrayDeque<>();
        for (int i = 0; i < n; i++) {
            Arrays.fill(fTime[i], -1);
            Arrays.fill(jTime[i], -1);
        }
        for (int i = 0; i < n; i++) {
            String line = br.readLine();
            for (int j = 0; j < m; j++) {
                char c = line.charAt(j);
                graph[i][j] = c;
                if (c == '*') {
                    flameQueue.offer(new Node(i, j));
                    visited[i][j] = true;
                    fTime[i][j] = 0;
                } else if (c == '@') {
                    jihun = new Node(i, j);
                    jTime[i][j] = 0;
                }
            }
        }
        flameBFS(flameQueue);
        visited = new boolean[n][m];
        sb.append(jihunBFS(jihun) + "\n");
    }
    private static void flameBFS(ArrayDeque<Node> queue) {
        while (!queue.isEmpty()) {
            Node nowNode = queue.poll();

            int nowR = nowNode.row;
            int nowC = nowNode.col;

            for (int i = 0; i < 4; i++) {
                int nextR = nowR + dr[i];
                int nextC = nowC + dc[i];
                if (nextR < 0 || nextR >= n || nextC < 0 || nextC >= m) {
                    continue;
                }
                if (visited[nextR][nextC] || graph[nextR][nextC] == '#') {
                    continue;
                }
                queue.offer(new Node(nextR, nextC));
                visited[nextR][nextC] = true;
                fTime[nextR][nextC] = fTime[nowR][nowC] + 1;
            }
        }
    }
    private static String jihunBFS(Node jihun) {
        Deque<Node> queue = new ArrayDeque<>();
        queue.offer(jihun);
        visited[jihun.row][jihun.col] = true;

        while (!queue.isEmpty()) {
            Node nowNode = queue.poll();
            int nowR = nowNode.row;
            int nowC = nowNode.col;
            int nextTime = jTime[nowR][nowC] + 1;

            for (int i = 0; i < 4; i++) {
                int nextR = nowR + dr[i];
                int nextC = nowC + dc[i];


                if (nextR < 0 || nextR >= n || nextC < 0 || nextC >= m) {
                    if (fTime[nowR][nowC] == -1 || jTime[nowR][nowC] < fTime[nowR][nowC]) {
                        return nextTime + "";
                    } else {
                        continue;
                    }
                }
                if (visited[nextR][nextC] || graph[nextR][nextC] == '#' || graph[nextR][nextC] == '*') {
                    continue;
                }
                if (fTime[nextR][nextC] != -1 && nextTime >= fTime[nextR][nextC]) {
                    continue;
                }

                queue.offer(new Node(nextR, nextC));
                visited[nextR][nextC] = true;
                jTime[nextR][nextC] = jTime[nowR][nowC] + 1;
            }
        }
        return "IMPOSSIBLE";
    }
    static class Node {
        int row;
        int col;

        public Node(int row, int col) {
            this.row = row;
            this.col = col;
        }
    }
}
