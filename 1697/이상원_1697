import java.util.*;
import java.io.*;

class Main {
    static int n;
    static int k;
    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        String[] input = br.readLine().split(" ");
        n = Integer.parseInt(input[0]);
        k = Integer.parseInt(input[1]);

        System.out.println(func());
    }
    private static int func() {
        int result = 0;

        Queue<int[]> q = new ArrayDeque<>();
        boolean[] visited = new boolean[100001];

        q.offer(new int[] {n, 0});
        visited[n] = true;



        while (!q.isEmpty()) {
            int[] poll = q.poll();
            int num = poll[0];
            int sec = poll[1];
            System.out.println("curSec :" + sec + "curNum" + num);

            if (num == k) {
                result = sec;
                break;
            }

            int[] dx = {1, -1, num * 2};

            for (int i = 0; i < 3; i++) {
                if (i != 2) {
                    int nx = num + dx[i];

                    if (nx < 0 || nx > 100000 || visited[nx]) continue;

                    q.offer(new int[]{nx, sec + 1});
                    visited[nx] = true;
                } else {
                    int nx = dx[i];

                    if (nx < 0 || nx > 100000 || visited[nx]) continue;

                    q.offer(new int[]{nx, sec + 1});
                    visited[nx] = true;
                }
            }


        }

        return result;
    }

}
